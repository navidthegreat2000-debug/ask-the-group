e": 0.09970569532957338, "front": 0.09970569532957338, "doors": 0.09970569532957338, "locked": 0.09970569532957338, "parking": 0.09319421115836073, "normal": 0.09319421115836073, "round": 0.09319421115836073, "reminder": 0.08768882973595864, "hall": 0.08768882973595864, "early": 0.08291985142793999, "back": 0.08291985142793999, "saturday": 0.078713314440212, "30": 0.07495043888100393, "school": 0.07495043888100393, "car": 0.07495043888100393, "park": 0.07495043888100393, "saturdays": 0.07154650388799232, "match": 0.07154650388799232}}, {"source": "emails.txt", "chunk": "PARKING\nOn normal Saturdays, use the school car park round the back. On match\ndays it fills up early, so use the church car park instead — it's about\na 3 minute walk.\nWHAT TO WEAR\nComfortable clothes. Closed-toe shoes in the kitchen (safety). Aprons", "length": 31, "vector": {"use": 0.1353943412043942, "car": 0.1353943412043942, "park": 0.1353943412043942, "instead": 0.11961452261620033, "about": 0.11961452261620033, "minute": 0.11961452261620033, "fills": 0.09725493614652467, "comfortable": 0.09725493614652467, "clothes": 0.09725493614652467, "aprons": 0.09725493614652467, "parking": 0.08417541653013227, "normal": 0.08417541653013227, "round": 0.08417541653013227, "closed": 0.08417541653013227, "toe": 0.08417541653013227, "shoes": 0.08417541653013227, "walk": 0.07920281395505942, "wear": 0.07920281395505942, "back": 0.07489534967684902, "early": 0.07489534967684902, "safety": 0.07489534967684902, "church": 0.07109589691373987, "school": 0.0676971706021971, "saturdays": 0.06462264867302532, "match": 0.06462264867302532, "days": 0.06462264867302532, "it's": 0.06462264867302532, "kitchen": 0.046992206532119836}}, {"source": "emails.txt", "chunk": "WHAT TO WEAR\nComfortable clothes. Closed-toe shoes in the kitchen (safety). Aprons\nare provided — spares are in the cupboard by the sink.\nIF YOU CAN'T MAKE IT\nText the group number as early as you can so we can find cover. The\nnumber is 555-0199. Please don't email — I don't check it on Saturdays.", "length": 30, "vector": {"number": 0.1739625274956067, "don't": 0.13355347392425232, "provided": 0.11008616976646819, "comfortable": 0.10049676735140882, "clothes": 0.10049676735140882, "aprons": 0.10049676735140882, "spares": 0.10049676735140882, "cupboard": 0.10049676735140882, "find": 0.10049676735140882, "cover": 0.10049676735140882, "check": 0.10049676735140882, "sink": 0.09305864897426849, "make": 0.09305864897426849, "group": 0.09305864897426849, "please": 0.09305864897426849, "closed": 0.08698126374780335, "toe": 0.08698126374780335, "shoes": 0.08698126374780335, "text": 0.08698126374780335, "555": 0.08698126374780335, "0199": 0.08698126374780335, "email": 0.08698126374780335, "wear": 0.0818429077535614, "can't": 0.0818429077535614, "safety": 0.07739186133274399, "early": 0.07739186133274399, "saturdays": 0.06677673696212616, "kitchen": 0.04855861341652383}}, {"source": "emails.txt", "chunk": "Text the group number as early as you can so we can find cover. The\nnumber is 555-0199. Please don't email — I don't check it on Saturdays.\nKITCHEN\nThe kitchen opens at 10am, and we start serving at 10:30. Kitchen\nshifts are 3 hours. Food pantry shifts are 2 hours. Setup is 1 hour.\nCERTIFICATES", "length": 33, "vector": {"shifts": 0.16919754358957909, "number": 0.15814775226873337, "hours": 0.15814775226873337, "kitchen": 0.132432582045065, "don't": 0.12141224902204757, "start": 0.10007833615133473, "certificates": 0.10007833615133473, "find": 0.09136069759218984, "cover": 0.09136069759218984, "check": 0.09136069759218984, "opens": 0.09136069759218984, "10am": 0.09136069759218984, "serving": 0.09136069759218984, "group": 0.08459877179478954, "please": 0.08459877179478954, "hour": 0.08459877179478954, "text": 0.07907387613436669, "555": 0.07907387613436669, "0199": 0.07907387613436669, "email": 0.07907387613436669, "early": 0.07035623757522182, "10": 0.06359431177782152, "30": 0.06359431177782152, "food": 0.06359431177782152, "setup": 0.06359431177782152, "saturdays": 0.060706124511023786, "pantry": 0.060706124511023786}}, {"source": "emails.txt", "chunk": "shifts are 3 hours. Food pantry shifts are 2 hours. Setup is 1 hour.\nCERTIFICATES\nKitchen volunteers need a food hygiene certificate. Pantry volunteers\ndon't. If you need one, we can help you book the free online course\nthrough the council.\nThanks,", "length": 28, "vector": {"shifts": 0.19941139065914676, "hours": 0.18638842231672145, "need": 0.16583970285587998, "food": 0.14990087776200786, "volunteers": 0.14990087776200786, "pantry": 0.14309300777598463, "certificates": 0.1179494676069302, "thanks": 0.1179494676069302, "hygiene": 0.10767510787650944, "book": 0.10767510787650944, "online": 0.10767510787650944, "course": 0.10767510787650944, "hour": 0.09970569532957338, "free": 0.09970569532957338, "certificate": 0.09319421115836073, "through": 0.09319421115836073, "one": 0.08768882973595864, "help": 0.08768882973595864, "council": 0.08768882973595864, "setup": 0.07495043888100393, "don't": 0.07154650388799232, "kitchen": 0.05202708580341839}}, {"source": "emails.txt", "chunk": "through the council.\nThanks,\nMaria\n---\nFrom: Maria Lopez\nTo: Volunteers", "length": 7, "vector": {"maria": 0.4837563373028415, "thanks": 0.4717978704277208, "lopez": 0.43070043150603776, "through": 0.3727768446334429, "council": 0.35075531894383455, "volunteers": 0.2998017555240157}}, {"source": "emails.txt", "chunk": "From: Maria Lopez\nTo: Volunteers\nSubject: Training and rota\nHi all,\nTwo quick things.\n1. Training day is the first Saturday of every month, 9am, in the hall.", "length": 19, "vector": {"training": 0.25845128764282543, "subject": 0.1738202680523182, "hi": 0.1738202680523182, "all": 0.1738202680523182, "two": 0.1738202680523182, "quick": 0.1738202680523182, "things": 0.1738202680523182, "lopez": 0.15867910634432972, "rota": 0.14693470890673974, "day": 0.12922564382141272, "month": 0.12922564382141272, "9am": 0.12922564382141272, "hall": 0.12922564382141272, "every": 0.12219767578854314, "saturday": 0.11599856864873347, "volunteers": 0.11045327835095316, "first": 0.10543695309809394, "maria": 0.08911300950315501}}, {"source": "emails.txt", "chunk": "Two quick things.\n1. Training day is the first Saturday of every month, 9am, in the hall.\nIt's not mandatory but it's useful for new volunteers.\n2. April rota will go out by the 25th of March. If you have any days\nyou can't do, let me know before then.\nAlso — a reminder that the first aid kit is on the kitchen wall, next", "length": 36, "vector": {"first": 0.11129456160354359, "it's": 0.11129456160354359, "march": 0.10300139447506139, "any": 0.10300139447506139, "two": 0.09173847480539016, "quick": 0.09173847480539016, "things": 0.09173847480539016, "mandatory": 0.09173847480539016, "useful": 0.09173847480539016, "april": 0.09173847480539016, "let": 0.09173847480539016, "also": 0.09173847480539016, "new": 0.08374730612617401, "go": 0.08374730612617401, "25th": 0.08374730612617401, "know": 0.08374730612617401, "rota": 0.07754887414522374, "before": 0.07754887414522374, "kit": 0.07248438645650279, "training": 0.06820242312796783, "day": 0.06820242312796783, "month": 0.06820242312796783, "9am": 0.06820242312796783, "hall": 0.06820242312796783, "can't": 0.06820242312796783, "reminder": 0.06820242312796783, "aid": 0.06820242312796783, "wall": 0.06820242312796783, "next": 0.06820242312796783, "every": 0.06449321777728666, "saturday": 0.061221466786831547, "volunteers": 0.05829478579633639, "days": 0.055647280801771795, "kitchen": 0.04046551118043652}}, {"source": "emails.txt", "chunk": "you can't do, let me know before then.\nAlso — a reminder that the first aid kit is on the kitchen wall, next\nto the fire extinguisher. Both get checked monthly. If you notice\nanything missing, tell me.\nMaria", "length": 22, "vector": {"notice": 0.16854773641373683, "let": 0.1501175042270021, "also": 0.1501175042270021, "missing": 0.1501175042270021, "tell": 0.1501175042270021, "know": 0.13704104638828477, "before": 0.12689815769218432, "extinguisher": 0.12689815769218432, "both": 0.12689815769218432, "anything": 0.12689815769218432, "kit": 0.11861081420155002, "fire": 0.11861081420155002, "monthly": 0.11861081420155002, "can't": 0.11160396511849283, "reminder": 0.11160396511849283, "aid": 0.11160396511849283, "wall": 0.11160396511849283, "next": 0.11160396511849283, "checked": 0.11160396511849283, "first": 0.09105918676653567, "maria": 0.07696123547999752, "kitchen": 0.0662162910225325}}, {"source": "onboarding.md", "chunk": "# New Volunteer Guide\nWelcome! Here's what you need to know before your first shift.\n## When is my shift?\nShifts are listed on the shared rota, which is sent out monthly.\n- **Setup shift:** 1 hour, starts at 8am\n- **Food pantry shift:** 2 hours", "length": 26, "vector": {"shift": 0.35719320615112615, "volunteer": 0.1426173154270081, "guide": 0.1426173154270081, "welcome": 0.1426173154270081, "here's": 0.1426173154270081, "listed": 0.1426173154270081, "shared": 0.1426173154270081, "sent": 0.1426173154270081, "new": 0.1159578084823948, "know": 0.1159578084823948, "before": 0.10737536420107904, "shifts": 0.10737536420107904, "rota": 0.10737536420107904, "hour": 0.10737536420107904, "starts": 0.10737536420107904, "8am": 0.10737536420107904, "monthly": 0.1003629966320808, "hours": 0.1003629966320808, "need": 0.08929830153778154, "setup": 0.08071585725646577, "food": 0.08071585725646577, "first": 0.07705008111014558, "pantry": 0.07705008111014558}}, {"source": "onboarding.md", "chunk": "- **Setup shift:** 1 hour, starts at 8am\n- **Food pantry shift:** 2 hours\n- **Kitchen shift:** 3 hours, opens at 10am, serving starts 10:30\n## Where do I go?\nCome to the hall. On setup, use the side entrance — the front doors\nare locked until 8:30.", "length": 30, "vector": {"shift": 0.232175583998232, "starts": 0.18611729794853699, "hours": 0.1739625274956067, "setup": 0.13990748591120733, "30": 0.13990