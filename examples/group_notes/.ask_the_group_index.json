 13, "vector": {"training": 0.37773649732412956, "mandatory": 0.2540450071533882, "useful": 0.2540450071533882, "there's": 0.2319156169647896, "new": 0.2319156169647896, "day": 0.18886824866206478, "month": 0.18886824866206478, "9am": 0.18886824866206478, "every": 0.17859660307556308, "saturday": 0.16953636956353355, "volunteers": 0.16143171451293153, "first": 0.15410016222029116}}, {"source": "watsapp2024.txt", "chunk": "[2024-02-10 08:14] Maria: Morning all — setup today starts at 8am in the hall. I open the doors.\n[2024-02-10 08:15] Maria: If you're on the 8am slot, come to the side entrance, not the front.\n[2024-02-10 08:16] Maria: Front doors stay locked till 8:30.\n[2024-02-10 08:20] Pedro: Where do we park?\n[2024-02-10 08:21] Maria: Normal Saturdays — school car park, round the back.\n[2024-02-10 08:22] Maria: Match days it's full, so use the church car park. 3 min walk.", "length": 76, "vector": {"08": 0.2060082562447974, "02": 0.1739978529731002, "2024": 0.16567991752642972, "10": 0.16567991752642972, "maria": 0.11139126187894377, "park": 0.08283995876321486, "8am": 0.07346735445336987, "doors": 0.07346735445336987, "front": 0.07346735445336987, "car": 0.05522663917547658, "morning": 0.04879013422502908, "till": 0.04879013422502908, "all": 0.04345506701307955, "slot": 0.04345506701307955, "21": 0.04345506701307955, "today": 0.03966977658608243, "open": 0.03966977658608243, "come": 0.03966977658608243, "stay": 0.03966977658608243, "full": 0.03966977658608243, "14": 0.036733677226684934, "starts": 0.036733677226684934, "15": 0.036733677226684934, "you're": 0.036733677226684934, "side": 0.036733677226684934, "entrance": 0.036733677226684934, "locked": 0.036733677226684934, "20": 0.034334709374132896, "normal": 0.034334709374132896, "round": 0.034334709374132896, "22": 0.034334709374132896, "min": 0.034334709374132896, "hall": 0.03230641095535318, "16": 0.03230641095535318, "walk": 0.03230641095535318, "back": 0.030549418947135785, "church": 0.02899964216218